PORT=4000
NODE_ENV=development
JWT_SECRET=fkesjhfkhrgt654654
JWT_EXPIRES_IN=7d
OTP_PEPPER=fkesjhfkhrgt654654
DATABASE_PATH=./data/padosipro.db
BCRYPT_ROUNDS=10

# Leave every mail block empty to write emails into ./outbox and print the OTP in the API log.
# Local Gmail SMTP works on a network that allows port 465. EMAIL_* and SMTP_* are the same settings.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=PadosiPro <you@gmail.com>

# Hosted API (Railway hobby blocks SMTP). One-time OAuth for the Gmail account above,
# scope https://www.googleapis.com/auth/gmail.send, then: node scripts/gmail-oauth.mjs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional HTTPS providers. Used only when the Gmail refresh token is unset.
BREVO_API_KEY=
RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PadosiPro <noreply@padosipro.local>
OUTBOX_DIR=./outbox
